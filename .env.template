# OpenAI API key for AI analysis
# Copy this file to .env and fill in your API key
OPENAI_API_KEY=your_api_key_here

# Set to "true" to use the real OpenAI API, "false" to use mock analysis
USE_REAL_AI=false

# GPT model selection (options: gpt-3.5-turbo, gpt-4, gpt-4-turbo, gpt-4o)
GPT_MODEL=gpt-3.5-turbo

# Analysis options
# Set to "true" to print GPT prompts and responses for debugging
DEBUG_AI=false

# Set to "true" to use AI analysis (requires OpenAI API key)
# Set to "false" to rely only on traditional keyword-based analysis
# USE_AI_ANALYSIS=true

# Use traditional keyword analysis for detecting opportunities
USE_TRADITIONAL_ANALYSIS=false

# CryptoPanic API for cryptocurrency news aggregation
CRYPTOPANIC_API_KEY=your_cryptopanic_api_key_here

# Use simplified output mode - only shows essential information
SIMPLIFIED_OUTPUT=true

# Email notification settings
# Set to "true" to enable email notifications
EMAIL_ENABLED=false
# Your email address that will send notifications
EMAIL_SENDER=your.email@gmail.com
# App password for your email account (for Gmail, create an app password in Google Account settings)
EMAIL_PASSWORD=your-app-password
# Comma-separated list of email recipients
EMAIL_RECIPIENTS=recipient1@example.com,recipient2@example.com
# Frequency of emails: "instant" (send immediately), "hourly", or "daily" (digest)
EMAIL_FREQUENCY=instant
# SMTP server and port (usually no need to change for Gmail)
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
